model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["DIM_TEMPO","DIM_DSEI","FATO_SAUDE","DIM_INDICADOR"]

annotation PBI_ProTooling = ["DevMode"]

ref table DIM_TEMPO
ref table DIM_DSEI
ref table FATO_SAUDE
ref table MEDIDAS
ref table DIM_INDICADOR

ref role RLS_AM
ref role RLS_AC

ref cultureInfo pt-BR

